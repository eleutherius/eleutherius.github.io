---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getPublishedPosts, postUrl } from "../lib/posts";
import { readingTime } from "../lib/readingTime";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import { CONTACT_EMAIL, LINKEDIN_URL } from "../config";
import wayfareImg from "../assets/images/wayfare.png";

dayjs.extend(localizedFormat);
const last_posts = (await getPublishedPosts()).slice(0, 2);

// The recruiter card beside the hero. A recruiter scanning this page has three
// questions: what is the role, does location/time zone/relocation fit, and how
// do I reach him. Every row answers one of them, in the order they're asked.
const spec = [
  { label: "Role", value: "Senior Platform / DevOps Engineer" },
  { label: "Experience", value: "In IT since 2014, 7+ years at Johnson Controls" },
  { label: "Core stack", value: "Kubernetes, ArgoCD, Terraform, Ansible, AWS, GitLab CI" },
  { label: "Based", value: "Ho Chi Minh City, Vietnam (UTC+7). Open to relocating anywhere." },
  { label: "Availability", value: "Open to full-time roles and contracts" },
];

// Recruiters scan for keywords and shouldn't have to open the CV to find them.
const stack = [
  { group: "Orchestration", items: ["Kubernetes", "Helm", "ArgoCD", "Docker"] },
  { group: "Cloud and IaC", items: ["AWS", "Terraform", "Ansible", "Linux"] },
  { group: "Delivery", items: ["GitHub Actions", "GitLab CI", "Bash", "Python"] },
  { group: "Observability", items: ["Prometheus", "Grafana", "Loki", "OpenTelemetry"] },
];
---

<BaseLayout sideBarActiveItemID="home">
  <!-- Hero. The headline is the one loud element on the site: set big in the
       condensed face across the full width, like the title on a drawing. The
       lede and the recruiter card share the row under it. -->
  <section class="hero">
    <h1 class="i-display hero-title"><span>I make infrastructure boring,</span> <span>so product teams can ship fast.</span></h1>

    <div class="hero-body">
      <div class="flex flex-col gap-8">
        <p class="i-lede">
          I'm Oleksandr — a senior platform engineer who builds the paved road: Kubernetes platforms, Terraform-managed
          cloud, CI/CD developers don't fight, and observability that catches trouble before users do. I also ship small
          products of my own.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={`mailto:${CONTACT_EMAIL}`} class="i-btn i-btn-primary">Hire me for platform work</a>
          <a href="/cv" class="i-btn i-btn-secondary">Read the CV</a>
        </div>
      </div>

      <!-- The title block: hairline cells, label over value. -->
      <dl class="blueprint spec">
        {
          spec.map((row) => (
            <div class="spec-row">
              <dt class="i-label">{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
        <div class="spec-row">
          <dt class="i-label">Contact</dt>
          <dd class="flex flex-wrap gap-x-5 gap-y-1">
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
          </dd>
        </div>
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
      </dl>
    </div>
  </section>

  <section class="i-section">
    <div class="i-section-head">
      <h2 class="i-h2">Things I built and run</h2>
      <a href="/projects" class="i-link">All projects</a>
    </div>

    <!-- Flagship full width, the two repos side by side, the small one as a
         slim row. Uneven cell sizes are what give a grid rhythm. -->
    <div class="grid md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <HorizontalCard
          title="Wayfare"
          img={wayfareImg}
          desc="A personal travel guide where every place and route is typed Markdown, rendered onto interactive Leaflet maps at build time. Content lives in git; the site stays static and fast."
          url="https://eleutherius.github.io/wayfare"
          badge="Live product"
          tags={["Astro", "Leaflet", "Markdown content"]}
        />
      </div>
      <HorizontalCard
        title="btrepl"
        desc="Incremental btrfs geo-replication over SSH, driven by a systemd timer — offsite snapshots without a backup vendor."
        url="https://github.com/eleutherius/btrepl"
        badge="Open source"
        tags={["Bash", "systemd", "btrfs"]}
      />
      <HorizontalCard
        title="Platform Engineer Laboratory"
        desc="Runnable reference setups for the platform stack — the sandbox behind everything I write about."
        url="https://github.com/eleutherius/pe-lab"
        badge="Lab and notes"
        tags={["Kubernetes", "Terraform", "CI/CD"]}
      />
      <a href="https://eleutherius.github.io/seven-minute-workout" class="i-card slim md:col-span-2">
        <div class="flex items-baseline gap-x-5 gap-y-1 flex-wrap">
          <h3 class="i-h4">7 minutes</h3>
          <p class="slim-desc">Offline-first PWA for morning home workouts.</p>
        </div>
        <div class="flex items-center gap-5">
          <span class="i-tag i-tag-outline">PWA</span>
          <span class="i-link">Open</span>
        </div>
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
      </a>
    </div>
  </section>

  <section class="i-section">
    <div class="i-section-head">
      <h2 class="i-h2">What I work in daily</h2>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-8">
      {
        stack.map((col) => (
          <div>
            <h3 class="stack-head">{col.group}</h3>
            <ul class="stack-list">
              {col.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  {
    last_posts.length > 0 && (
      <section class="i-section">
        <div class="i-section-head">
          <h2 class="i-h2">Latest from the blog</h2>
          <a href="/blog/" class="i-link">All posts</a>
        </div>

        <div class="flex flex-col gap-6">
          {last_posts.map((post) => (
            <HorizontalCard
              title={post.data.title}
              img={post.data.heroImage}
              desc={post.data.description}
              url={postUrl(post)}
              target="_self"
              tags={post.data.tags}
              date={dayjs(post.data.pubDate).format("ll")}
              readingTime={readingTime(post.body)}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="i-section blueprint contact">
    <div style="max-width: 46ch;">
      <h2 class="i-h2 contact-title">Hiring for platform, SRE or DevOps?</h2>
      <p class="contact-text">
        Tell me what breaks today and what you want shipped next quarter. I reply within a day, and I'll say plainly if
        I'm not the right fit.
      </p>
    </div>
    <a href={`mailto:${CONTACT_EMAIL}`} class="i-btn contact-btn">Get in touch</a>
    <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-8);
    padding-top: var(--space-4);
  }
  /* On a phone the headline wraps where it must (balanced, no lone last word).
     Where there is room, each clause holds together so the break falls at the
     comma: two lines, one thought per line. */
  .hero-title {
    max-width: 21ch;
  }
  @media (min-width: 1100px) {
    .hero-title {
      max-width: none;
    }
    .hero-title span {
      display: inline-block;
    }
  }
  .hero-body {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }
  @media (min-width: 1100px) {
    .hero-body {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-12);
    }
  }

  .spec {
    margin: 0;
  }
  .spec-row {
    padding: var(--space-3) var(--space-6);
  }
  .spec-row + .spec-row {
    border-top: 1px solid var(--color-divider);
  }
  .spec-row dt {
    margin-bottom: var(--space-1);
  }
  .spec-row dd {
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .slim {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding: var(--space-4) var(--space-6);
  }
  .slim-desc {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-neutral-700);
  }

  .stack-head {
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-divider);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.2;
  }
  .stack-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
    color: var(--color-neutral-800);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-8);
    background: var(--color-accent-900);
    color: var(--color-bg);
  }
  .contact-title {
    color: var(--color-bg);
    margin-bottom: var(--space-3);
  }
  /* Light text on the dark panel: a touch more leading, as the eye needs it. */
  .contact-text {
    margin: 0;
    line-height: 1.65;
    color: var(--color-accent-200);
    text-wrap: pretty;
  }
  .contact-btn {
    background: var(--color-bg);
    border-color: var(--color-bg);
    color: var(--color-accent-900);
    padding-inline: var(--space-8);
  }
  .contact-btn:hover {
    background: var(--color-accent-100);
    border-color: var(--color-accent-100);
    color: var(--color-accent-900);
  }
</style>
