---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import { getPublishedPosts, postUrl } from "../../../../lib/posts";
import { readingTime } from "../../../../lib/readingTime";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export async function getStaticPaths({ paginate }) {
  const all_posts = await getPublishedPosts();
  // Sorted once, up front. This used to call all_tags.sort() inside the loop
  // below: sorting the array mid-iteration made flatMap visit one tag twice and
  // skip another, so /blog/tag/btrepl was never generated and its link 404'd.
  const all_tags = [...new Set(all_posts.flatMap((post) => post.data.tags || []))].sort();

  return all_tags.flatMap((tag) => {
    const filtred_posts = all_posts.filter((post) => post.data.tags?.includes(tag));
    return paginate(filtred_posts, {
      params: { tag },
      pageSize: 10,
      props: { tags: all_tags },
    });
  });
}

const { page, tags } = Astro.props;
const params = Astro.params;
dayjs.extend(localizedFormat);
---

<BaseLayout title={"Blog — " + params.tag} sideBarActiveItemID="blog">
  <header style="border-bottom: 1px solid var(--color-divider); padding-bottom: var(--space-6); margin-bottom: var(--space-6);">
    <div class="i-kicker" style="margin-bottom: var(--space-3);">Tagged</div>
    <h1 class="i-h1">{params.tag}</h1>
  </header>

  <div class="flex flex-wrap items-center gap-2" style="margin-bottom: var(--space-8);">
    <span class="i-kicker" style="font-size: 12px; margin-right: var(--space-2);">Filter</span>
    <a href="/blog/" class="i-tag i-tag-outline">All</a>
    {
      tags.map((tag) =>
        tag === params.tag ? (
          <span class="i-tag i-tag-accent">{tag}</span>
        ) : (
          <a href={`/blog/tag/${tag}`} class="i-tag i-tag-outline">
            {tag}
          </a>
        )
      )
    }
  </div>

  {
    page.data.length === 0 ? (
      <div style="border-left: 2px solid var(--color-accent); padding: var(--space-4) var(--space-6); background: var(--color-accent-100);">
        <p style="margin: 0; font-size: 15px;">No posts under this tag yet.</p>
      </div>
    ) : (
      <div class="flex flex-col gap-6">
        {page.data.map((post) => (
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={postUrl(post)}
            target="_self"
            badge={post.data.draft ? "Draft" : post.data.badge}
            tags={post.data.tags}
            date={dayjs(post.data.pubDate).format("ll")}
            readingTime={readingTime(post.body)}
          />
        ))}
      </div>
    )
  }

  {
    (page.url.prev || page.url.next) && (
      <div
        class="flex justify-between"
        style="border-top: 1px solid var(--color-divider); margin-top: calc(var(--space-8) * 1.4); padding-top: var(--space-6);"
      >
        {page.url.prev ? (
          <a href={page.url.prev} class="i-btn i-btn-secondary">
            ← Recent posts
          </a>
        ) : (
          <span />
        )}
        {page.url.next ? (
          <a href={page.url.next} class="i-btn i-btn-secondary">
            Older posts →
          </a>
        ) : (
          <span />
        )}
      </div>
    )
  }
</BaseLayout>
