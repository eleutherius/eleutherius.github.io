---
import { NAV } from "../config";
const { active } = Astro.props;
---

<!-- Narrow screens only. Four destinations fit on one line at 360px, so they
     are shown, not hidden behind a menu button. Not sticky: on a phone the
     screen height belongs to the content. -->
<header class="site-bar no-print">
  <a href="/" class="bar-name">
    <span class="bar-mark" aria-hidden="true"></span>
    Oleksandr Liakhov
  </a>
  <nav class="i-nav i-nav-bar" aria-label="Main">
    {NAV.map((item) => <a href={item.href} aria-current={active === item.id ? "page" : undefined}>{item.label}</a>)}
  </nav>
</header>

<style>
  .site-bar {
    padding: var(--space-4) var(--space-6) 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .bar-name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }
  .bar-mark {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--color-accent);
  }
</style>
